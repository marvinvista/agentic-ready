{
  "openapi": "3.1.0",
  "info": { "title": "Ready Product API", "version": "1.0.0" },
  "paths": {
    "/v1/tasks": {
      "post": {
        "security": [{ "apiKey": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Example response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TaskResponse" },
                "example": { "id": "task_123", "status": "complete" }
              }
            }
          },
          "400": {
            "description": "Error model",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskRequest": { "type": "object", "properties": { "input": { "type": "string" } } },
      "TaskResponse": { "type": "object", "properties": { "id": { "type": "string" } } },
      "Error": { "type": "object", "properties": { "code": { "type": "string" } } }
    }
  }
}
